# Required only for Best Parts. Extracted audio and the transcript are sent to OpenAI.
# OpenAI API usage may incur charges. Sequence Wise runs locally without this key.
OPENAI_API_KEY=your_api_key_here
OPENAI_HIGHLIGHT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Hosted deployment security. Set the public HTTPS site URL and unique secrets.
APP_BASE_URL=
APP_PASSWORD=replace_with_a_long_private_password
APP_SESSION_SECRET=replace_with_random_secret_at_least_32_chars
TOKEN_ENCRYPTION_KEY=replace_with_a_fernet_key_before_connecting_accounts

# OAuth provider apps: register each callback as https://your-domain.example/api/social/{provider}/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_GRAPH_VERSION=v23.0
